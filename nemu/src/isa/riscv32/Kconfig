menu "ISA-dependent Options for riscv"

config RV64
  bool "64-bit RISC-V architecture"
  default n

config RVE
  bool "Use E extension"
  default n

config RISCV_F
  bool "F extension (single-precision floating point)"
  default n
  depends on !TARGET_AM && !RVE
  help
    实现 RV32/RV64 的 F 扩展：FLW/FSW、FMV、FADD/SUB/MUL/DIV/
    SQRT、FMIN/MAX、FSGNJ、FEQ/FLT/FLE、FCLASS、FCVT 和 FMA。
    浮点运算由仓库内 tools/softfloat 的 Berkeley SoftFloat 完成，
    严格执行 RISC-V 的舍入模式、canonical NaN 与 fflags 语义。
    默认关闭，避免改变现有整数参考模型和 DiffTest 状态布局。

config RISCV_D
  bool "D extension (double-precision floating point)"
  default n
  depends on RISCV_F && !TARGET_AM
  help
    实现 RV32/RV64 的 D 扩展：FLD/FSD、D 精度算术/比较/转换/FMA，
    以及 RV64 的 FMV.X.D/FMV.D.X。D 依赖 F。打开后 f 寄存器按
    FLEN=64 保存，单精度结果使用标准 NaN boxing。

config RISCV_A
  bool "A extension (LR/SC and AMO)"
  default y
  help
    实现 RV32/RV64 的 LR/SC 与 AMO 指令。xv6-riscv 的
    spinlock 需要 AMOSWAP.W；其余 AMO 也一并实现，供 DiffTest
    与编译器原子模式使用。

config RISCV_C
  bool "C extension (compressed 16-bit instructions)"
  default n
  help
    实现 RV32C/RV64C 压缩指令扩展：取指长度可在 16/32 位之间
    变化，PC 允许 2 字节对齐，misa.C 置位。默认关闭，避免改变
    现有 RV32/RV64 参考模型的 IALIGN=32 行为。
    开启后仍只接受合法的 C 编码；保留/非法编码按非法指令陷入。

# 兼容外部脚本常用的 CONFIG_RVC 名称。真正的菜单项是 RISCV_C，
# 这个隐藏符号只负责在 autoconf.h 中同时生成 CONFIG_RVC。
config RVC
  bool
  default y if RISCV_C
endmenu
