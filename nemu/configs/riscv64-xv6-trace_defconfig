# RV64 xv6 golden trace 构建：只在 usertrap / userret 附近写 ITRACE
CONFIG_ISA_riscv=y
CONFIG_RV64=y
CONFIG_RISCV_A=y
CONFIG_TARGET_NATIVE_ELF=y
CONFIG_MSIZE=0x8000000
CONFIG_DEVICE=y
CONFIG_HAS_RISCV_XV6=y
# CONFIG_HAS_SERIAL is not set
# CONFIG_HAS_TIMER is not set
# CONFIG_HAS_KEYBOARD is not set
# CONFIG_HAS_VGA is not set
# CONFIG_HAS_AUDIO is not set
# CONFIG_HAS_DISK is not set
CONFIG_TRACE=y
CONFIG_TRACE_START=0
CONFIG_TRACE_END=2000000000
CONFIG_ITRACE=y
# xv6-riscv PLATFORM=nemu 的固定地址：
#   prepare_return/usertrap = 0x80003634..0x80003900
#   trampoline 运行时映射在 0x3ffffff000，userret 偏移 0xb0
CONFIG_ITRACE_COND="(cpu.pc>=0x80003600&&cpu.pc<=0x80003900)||(cpu.pc>=0x3ffffff000&&cpu.pc<=0x3ffffff200)"
CONFIG_IRINGBUF=y
CONFIG_IRINGBUF_SIZE=4096
CONFIG_ReadELF=y
# CONFIG_FTRACE is not set
# CONFIG_MTRACE is not set
# CONFIG_DTRACE is not set
# CONFIG_ETRACE is not set
# CONFIG_BTRACE is not set
# CONFIG_WATCHPOINT is not set
# CONFIG_DIFFTEST is not set
