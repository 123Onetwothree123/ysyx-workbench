# NPC RV32I 最小 M 模式预设（B 阶段基线）。
#
# ISA：只实现 RV32I，无 M/A/C/F/D；仅 M 特权级，无 S/U、无 MMU/TLB/PMP，
# 不启用 SBI/Linux/U-Boot。保留 B1 所需的最小 M 模式 CSR 与异常路径
# （mcycle/mcycleh、mvendorid/marchid 常量读口、ecall/mret）。
# ICache 按 B3 打开；DCache 按 B3 的面积结论关闭。
#
# 2607 B 阶段的 RTL 基线是“多周期 -> 流水线”；流水线没有 Kconfig 开关，
# 本文件只描述 ISA/CSR/缓存/平台参数，不代表微架构实现。
# 平台：direct-NPC，64 MiB @0x80000000，UART 0x10000000，CLINT 0x02000000。
CONFIG_XLEN=32
CONFIG_NPC_RAM_SIZE=0x04000000
CONFIG_SOC_XLEN=32

# ---- ISA：纯 RV32I ----
CONFIG_RISCV_M=n
CONFIG_RISCV_A=n
CONFIG_RISCV_C=n
CONFIG_RISCV_F=n
CONFIG_RISCV_D=n

# ---- 特权级：M-only ----
CONFIG_HAS_S=n
CONFIG_HAS_U=n
CONFIG_HAS_MMU=n
CONFIG_HAS_TLB=n
CONFIG_HAS_PMP=n

# ---- M 模式 CSR ----
CONFIG_CSR_MISSING_ILLEGAL=y
CONFIG_CSR_MISSING_MODE="illegal"
CONFIG_CSR_VIEW_BOUND=y
CONFIG_CSR_VIEW_MODE="bound"
CONFIG_CSR_FIELD_DEFAULT_READ="normal"
CONFIG_CSR_FIELD_DEFAULT_WRITE="normal"
CONFIG_HAS_CSR_MSTATUS=y
CONFIG_HAS_CSR_MISA=y
CONFIG_HAS_CSR_MTVEC=y
CONFIG_HAS_CSR_MEPC=y
CONFIG_HAS_CSR_MCAUSE=y
CONFIG_HAS_CSR_MTVAL=y
CONFIG_HAS_CSR_MSCRATCH=y
CONFIG_HAS_CSR_MIE=y
CONFIG_HAS_CSR_MIP=y
CONFIG_HAS_CSR_MCYCLE=y
CONFIG_HAS_CSR_MINSTRET=y

# ---- 定时器：M 模式 CLINT；B1 的时钟用 mcycle，不依赖定时器中断 ----
CONFIG_TIMER_CLINT_MTIP=y
CONFIG_TIMER_PATH="clint_mtip"

# ---- 缓存：B3 要求 ICache；DCache 按面积结论关闭 ----
CONFIG_CACHE_ENABLE=y
CONFIG_ICACHE=y
CONFIG_DCACHE=n
CONFIG_CACHE_BLOCK_SIZE_LOG2=4
CONFIG_CACHE_INDEX_BITS=4
CONFIG_ICACHE_STORAGE_REG=y
CONFIG_DCACHE_STORAGE_REG=y

# ---- 仿真/调试 ----
CONFIG_SDB=y
CONFIG_TRACE=y
CONFIG_DIFFTEST=n
CONFIG_LOG_TO_FILE=n
CONFIG_PERF_DIC_ARCH_COUNTER=n
CONFIG_PERF_SAVE=n

# ---- 明确关闭 ----
CONFIG_SBI_ENABLE=n
CONFIG_LINUX_BOOT_ENABLE=n
CONFIG_NPC_UBOOT_ENABLE=n
