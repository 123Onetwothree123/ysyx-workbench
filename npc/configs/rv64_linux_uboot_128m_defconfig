# NPC RV64GC U-Boot EFI + Debian 128 MiB 启动配置。
#
# 默认 rv64_linux_defconfig 仍是 64 MiB / 直接 OpenSBI->Linux 布局。
# 本配置只把 direct-NPC RAM 扩到 128 MiB，并改用 U-Boot EFI 路径：
#
#   0x80000000  OpenSBI FW_JUMP（预留 2 MiB，SBI_FW_BASE）
#   0x80200000  U-Boot（SBI_NEXT_ADDR，也是 CONFIG_TEXT_BASE）
#   0x80600000  可选 EFI 测试应用（initrddump.efi）
#   0x80800000  BusyBox initramfs（EFI_LOAD_FILE2）
#   0x81000000  Debian EFI vmlinux 源文件（efi_load_pe 会再分配目标页）
#   0x87f00000  DTB（SBI_FDT_ADDR，64 KiB 保留）
#   0x88000000  RAM 结束（128 MiB）
#
# 64 MiB 下 efi_load_pe() 需要同时容纳 29.7 MiB 源 PE + 30.4 MiB
# 目标页 + initrd，剩余空间不足；128 MiB 是 NEMU 已实测可行的规模。
#
# 与默认 Linux 配置一样，本配置不下载/编译 Linux；Image/initramfs
# 由调用者在运行时提供：
#   NPC_UBOOT_KERNEL_PATH=/path/vmlinux \
#   NPC_UBOOT_INITRAMFS_PATH=/path/initramfs.cpio.gz \
#     make uboot-image
CONFIG_XLEN=64
CONFIG_RISCV_M=y
CONFIG_RISCV_A=y
CONFIG_RISCV_C=y
CONFIG_RISCV_F=y
CONFIG_RISCV_D=y
CONFIG_FPU_IMPL_HARDFLOAT=y
CONFIG_FPU_FLEN=64
CONFIG_FPU_PIPELINE=0
CONFIG_FPU_FMA=y
CONFIG_FPU_DIVSQRT=y
CONFIG_FPU_ROUNDING=y
CONFIG_FPU_FLAGS=y
CONFIG_FPU_HARDFLOAT_RECODE=y
# CONFIG_FPU_HARDFLOAT_TININESS_BEFORE_ROUNDING is not set
# CONFIG_FPU_FUDIAN_SHARED_DIVSQRT is not set

# direct-NPC RAM：默认 64 MiB；Debian EFI 需要 128 MiB。
CONFIG_NPC_RAM_SIZE=0x08000000

CONFIG_HAS_S=y
CONFIG_HAS_U=y
CONFIG_HAS_MMU=y
CONFIG_HAS_TLB=y

CONFIG_MMU_PROFILE_BALANCED=y
CONFIG_MMU_GEOMETRY_STANDARD=y
CONFIG_MMU_GEOMETRY_MODE="standard"
CONFIG_MMU_CUSTOM_SATP_MODE=10
CONFIG_MMU_PAGE_SIZE_BYTES=4096
# Debian 6.12 在 no5lvl 下选择 Sv48（不是 Sv39）。NPC 标准几何必须
# 配 4 级页表；若仍是 3 级，satp.MODE=9 会被 WARL 收敛到 Bare，
# 内核在 csrw satp 后的下一条取指就会 Access Fault。
CONFIG_MMU_LEVELS=4
CONFIG_MMU_PTE_SIZE_BYTES=8
CONFIG_MMU_PAGE_TABLE_SIZE_BYTES=4096
CONFIG_MMU_PTE_RISCV64=y
CONFIG_MMU_PTE_FORMAT="riscv64"
CONFIG_MMU_SUPERPAGE=y
CONFIG_MMU_AD_FAULT=y
CONFIG_MMU_AD_MODE="fault"
CONFIG_MMU_CACHE_PIPT=y
CONFIG_MMU_CACHE_MODE="pipt"
CONFIG_MMU_PTW_DEDICATED=y
CONFIG_MMU_PTW_PATH="dedicated"
CONFIG_MMU_PTW_INDEPENDENT=y
CONFIG_MMU_PTW_ARCH="independent"
CONFIG_MMU_PTW_OUTSTANDING=2
CONFIG_MMU_PTW_BUS_OUTSTANDING=1
CONFIG_MMU_PTW_IN_ORDER=y
CONFIG_MMU_PTW_ORDER="in_order"
CONFIG_MMU_PTW_CACHE=n

CONFIG_TLB_SPLIT=y
CONFIG_TLB_ORGANIZATION="split"
CONFIG_TLB_STORAGE_REG=y
CONFIG_TLB_STORAGE="reg"
CONFIG_TLB_REPLACE_PLRU=y
CONFIG_TLB_REPLACEMENT="plru"
CONFIG_TLB_ASID_BITS=16
CONFIG_TLB_GLOBAL=y
CONFIG_ITLB_ENTRIES=16
CONFIG_ITLB_WAYS=2
CONFIG_DTLB_ENTRIES=32
CONFIG_DTLB_WAYS=4
CONFIG_TLB_SUPERPAGE=y
CONFIG_TLB_MISS_QUEUE_FOLLOW=y
CONFIG_TLB_MISS_QUEUE_MODE="follow_tlb"
CONFIG_ITLB_MISS_QUEUE_ENTRIES=4
CONFIG_DTLB_MISS_QUEUE_ENTRIES=4
CONFIG_TLB_REFILL_PORTS=1

CONFIG_HAS_S_TIMER_IRQ=y
CONFIG_HAS_S_EXTERNAL_IRQ=y
CONFIG_TIMER_CLINT_MTIP=y
CONFIG_TIMER_PATH="clint_mtip"
CONFIG_PLIC_SOURCES=32
CONFIG_PLIC_PRIORITY_BITS=3
CONFIG_PLIC_MAX_PRIORITY=7
CONFIG_PLIC_BASE=0x0c000000
CONFIG_HAS_PMP=y
CONFIG_PMP_ENTRIES=16

CONFIG_CSR_MISSING_ILLEGAL=y
CONFIG_CSR_MISSING_MODE="illegal"
CONFIG_CSR_VIEW_BOUND=y
CONFIG_CSR_VIEW_MODE="bound"
CONFIG_CSR_FIELD_DEFAULT_READ="normal"
CONFIG_CSR_FIELD_DEFAULT_WRITE="normal"

CONFIG_HAS_CSR_MSTATUS=y
CONFIG_HAS_CSR_MISA=y
CONFIG_HAS_CSR_MTVEC=y
CONFIG_HAS_CSR_MEPC=y
CONFIG_HAS_CSR_MCAUSE=y
CONFIG_HAS_CSR_MTVAL=y
CONFIG_HAS_CSR_MSCRATCH=y
CONFIG_HAS_CSR_MIE=y
CONFIG_HAS_CSR_MIP=y
CONFIG_HAS_CSR_MEDELEG=y
CONFIG_HAS_CSR_MIDELEG=y
CONFIG_HAS_CSR_MCOUNTEREN=y
CONFIG_HAS_CSR_MCOUNTINHIBIT=y
CONFIG_HAS_CSR_MCYCLE=y
CONFIG_HAS_CSR_MINSTRET=y
CONFIG_HAS_CSR_SSTATUS=y
CONFIG_HAS_CSR_SIE=y
CONFIG_HAS_CSR_SIP=y
CONFIG_HAS_CSR_STVEC=y
CONFIG_HAS_CSR_SSCRATCH=y
CONFIG_HAS_CSR_SEPC=y
CONFIG_HAS_CSR_SCAUSE=y
CONFIG_HAS_CSR_STVAL=y
CONFIG_HAS_CSR_SATP=y
CONFIG_HAS_CSR_SCOUNTEREN=y

# 仿真/调试：保留 SDB 以便 --batch 运行；irq/time 契约与默认 Linux 配置一致。
# ICache 打开、DCache 关闭：沿用当前已验证的 Linux 最小组合；U-Boot/
# Debian 内核的仿真很慢时再单独评估 DCache。
CONFIG_ICACHE=y
CONFIG_DCACHE=n
CONFIG_SDB=y
CONFIG_TRACE=n
CONFIG_FTRACE=n
CONFIG_IRINGBUF=n
CONFIG_ITRACE=n
CONFIG_MTRACE=n
CONFIG_DIFFTEST=n
CONFIG_LOG_TO_FILE=n
CONFIG_PERF_STATS=n
CONFIG_PERF_SAVE=n

# mtime 每个 CPU 周期 +1；DTB timebase 与 OpenSBI mtime_freq 都取 450MHz。
CONFIG_SYNTH_FREQ=450

# M 模式 SBI 固件：OpenSBI NPC 平台，FW_JUMP 到 U-Boot。
CONFIG_SBI_ENABLE=y
CONFIG_SBI_IMPL_OPENSBI=y
CONFIG_SBI_IMPL="opensbi"
CONFIG_SBI_PLATFORM="npc"
CONFIG_SBI_FW_BASE=0x80000000
CONFIG_SBI_FW_SIZE=0x00200000
CONFIG_SBI_NEXT_ADDR=0x80200000
CONFIG_SBI_BUILD_JOBS=0

# DTB 放在 128 MiB RAM 末尾前 1 MiB；64 MiB 默认配置仍是 0x83f00000。
CONFIG_SBI_FDT_ENABLE=y
CONFIG_SBI_FDT_PATH="dts/npc.dts"
CONFIG_SBI_FDT_ADDR=0x87f00000

# 不使用 make linux-image 的 raw Image 布局：本配置走 U-Boot EFI。
# CONFIG_LINUX_BOOT_ENABLE is not set

# U-Boot EFI 打包布局。路径留空；运行时用环境变量指定真实文件，
# 避免把 /tmp 或 Debian ISO 路径写进仓库。
CONFIG_NPC_UBOOT_ENABLE=y
CONFIG_NPC_UBOOT_EFI_APP_ADDR=0x80600000
CONFIG_NPC_UBOOT_INITRAMFS_ADDR=0x80800000
CONFIG_NPC_UBOOT_KERNEL_ADDR=0x81000000
CONFIG_NPC_UBOOT_BOOTARGS="console=ttyS0,115200 earlycon=sbi no5lvl cpuidle.off=1 loglevel=7"
