# NPC 可复用配置片段：AMD (Xilinx) FPGA 部署框架。
#
# 具体器件/板卡后续确定；这里先选择 AMD + UltraScale+ + Vivado，
# 其余 FPGA 选项使用 Kconfig 默认值，可在 menuconfig 中继续修改。
CONFIG_FPGA_ENABLE=y
# 默认与 Verilator 仿真共存；需要 FPGA 独占时改成 EXCLUSIVE。
CONFIG_FPGA_SIM_COEXIST=y
CONFIG_FPGA_VENDOR_AMD=y
CONFIG_FPGA_AMD_FAMILY_ULTRASCALE_PLUS=y
CONFIG_FPGA_TOOLCHAIN_VIVADO=y
