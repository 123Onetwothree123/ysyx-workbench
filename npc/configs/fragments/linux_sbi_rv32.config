# NPC 可复用配置片段：OpenSBI + FDT + RV32 Linux 启动布局。
#
# 需要先应用 base_rv32ima/base_rv32gc 与 mmu_sv32。
# 地址布局：
#   0x80000000  SBI 固件（2 MiB）
#   0x80200000  空洞；RV32 的 next-stage 不能放在这里
#   0x80400000  Linux Image（SBI_NEXT_ADDR，RV32 必须 4 MiB 对齐）
#   0x82000000  initramfs（可选）
#   0x83f00000  DTB（SBI_FDT_ADDR，64 KiB 保留）
#   0x84000000  RAM 结束（64 MiB）
#
# Image 头的 text_offset 必须为 0 或 0x400000；很多预编译 RV32 Image
# 使用 0x200000，会被 pack_linux_image 拒绝。
CONFIG_HAS_S_TIMER_IRQ=y
CONFIG_HAS_S_EXTERNAL_IRQ=y
CONFIG_TIMER_CLINT_MTIP=y
CONFIG_PLIC_SOURCES=32
CONFIG_PLIC_PRIORITY_BITS=3
CONFIG_PLIC_MAX_PRIORITY=7
CONFIG_PLIC_BASE=0x0c000000
CONFIG_PLIC_SIZE=0x00300000
CONFIG_HAS_PMP=y
CONFIG_PMP_ENTRIES=16

CONFIG_ICACHE=y
CONFIG_DCACHE=n
CONFIG_CACHE_BLOCK_SIZE_LOG2=4
CONFIG_CACHE_INDEX_BITS=5
CONFIG_ICACHE_STORAGE_REG=y

CONFIG_SYNTH_FREQ=450

CONFIG_SBI_ENABLE=y
CONFIG_SBI_IMPL_OPENSBI=y
CONFIG_SBI_PLATFORM="npc"
CONFIG_SBI_FW_BASE=0x80000000
CONFIG_SBI_FW_SIZE=0x00200000
CONFIG_SBI_NEXT_ADDR=0x80400000
CONFIG_SBI_BUILD_JOBS=0

CONFIG_SBI_FDT_ENABLE=y
CONFIG_SBI_FDT_PATH="dts/npc.dts"
CONFIG_SBI_FDT_ADDR=0x83f00000

CONFIG_LINUX_BOOT_ENABLE=y
CONFIG_LINUX_IMAGE_PATH="Image"
CONFIG_LINUX_BOOTARGS="console=ttyS0,115200 earlycon=sbi"
CONFIG_LINUX_INITRAMFS_ENABLE=y
CONFIG_LINUX_INITRAMFS_PATH="initramfs.cpio"
CONFIG_LINUX_INITRAMFS_ADDR=0x82000000
