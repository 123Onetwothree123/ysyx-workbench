# NPC 可复用配置片段：RV32GC 基线（RV32IMAFDC + Berkeley HardFloat，32 位 SoC）。
#
# 供 rv32gc_linux_defconfig 参考。F/D 需要完整 FPU 契约：
# FLEN=64、FMA、DIVSQRT、ROUNDING、FLAGS、HARDFLOAT_RECODE。
CONFIG_XLEN=32
CONFIG_NPC_RAM_SIZE=0x04000000
CONFIG_SOC_XLEN=32

CONFIG_RISCV_M=y
CONFIG_RISCV_A=y
CONFIG_RISCV_C=y
CONFIG_RISCV_F=y
CONFIG_RISCV_D=y

CONFIG_FPU_IMPL_HARDFLOAT=y
CONFIG_FPU_FLEN=64
CONFIG_FPU_PIPELINE=0
CONFIG_FPU_FMA=y
CONFIG_FPU_DIVSQRT=y
CONFIG_FPU_ROUNDING=y
CONFIG_FPU_FLAGS=y
CONFIG_FPU_HARDFLOAT_RECODE=y
# CONFIG_FPU_HARDFLOAT_TININESS_BEFORE_ROUNDING is not set
# CONFIG_FPU_FUDIAN_SHARED_DIVSQRT is not set
