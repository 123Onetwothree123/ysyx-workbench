# NPC 可复用配置片段：RV32 M/A 基线（无 F/D，32 位 SoC）。
#
# 供 rv32imac_linux_defconfig 参考；RVC 由使用方显式打开。
# 2607 B 阶段的 RTL 是“多周期 → 流水线”的升级路线，流水线没有
# Kconfig 开关；本片段只描述 ISA/平台参数。
CONFIG_XLEN=32
CONFIG_NPC_RAM_SIZE=0x04000000
CONFIG_SOC_XLEN=32

CONFIG_RISCV_M=y
CONFIG_RISCV_A=y
CONFIG_RISCV_C=n
CONFIG_RISCV_F=n
CONFIG_RISCV_D=n
