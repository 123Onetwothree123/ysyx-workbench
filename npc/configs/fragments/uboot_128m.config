# NPC 可复用配置片段：128 MiB RAM + U-Boot EFI 布局覆盖。
#
# 在 linux_sbi.config 之后应用，覆盖 RAM 大小、Sv48 4 级页表和 DTB 地址，
# 并关闭 make linux-image 的 raw Image 路径，改用 U-Boot EFI。
#   0x80000000  OpenSBI FW_JUMP（2 MiB）
#   0x80200000  U-Boot（SBI_NEXT_ADDR）
#   0x80600000  EFI 测试应用
#   0x80800000  BusyBox initramfs
#   0x81000000  Debian EFI vmlinux 源文件
#   0x87f00000  DTB（64 KiB 保留）
#   0x88000000  RAM 结束（128 MiB）
CONFIG_NPC_RAM_SIZE=0x08000000

# Debian 6.12 在 no5lvl 下使用 Sv48；标准几何必须配 4 级页表。
CONFIG_MMU_LEVELS=4

# DTB 移到 128 MiB RAM 末尾前 1 MiB。
CONFIG_SBI_FDT_ADDR=0x87f00000

# 本 profile 走 U-Boot EFI，不使用 make linux-image 的 raw Image 布局。
# CONFIG_LINUX_BOOT_ENABLE is not set

CONFIG_NPC_UBOOT_ENABLE=y
CONFIG_NPC_UBOOT_EFI_APP_ADDR=0x80600000
CONFIG_NPC_UBOOT_INITRAMFS_ADDR=0x80800000
CONFIG_NPC_UBOOT_KERNEL_ADDR=0x81000000
CONFIG_NPC_UBOOT_BOOTARGS="console=ttyS0,115200 earlycon=sbi no5lvl cpuidle.off=1 loglevel=7"
