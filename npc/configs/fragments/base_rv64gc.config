# NPC 可复用配置片段：RV64GC + Berkeley HardFloat 浮点后端。
#
# 作为 profile 的第一个片段使用；后续片段可以按需覆盖这里的任何符号
# （合并后的 defconfig 中，同名符号以最后出现的定义为准）。
CONFIG_XLEN=64
CONFIG_RISCV_M=y
CONFIG_RISCV_A=y
CONFIG_RISCV_C=y
CONFIG_RISCV_F=y
CONFIG_RISCV_D=y

CONFIG_FPU_IMPL_HARDFLOAT=y
CONFIG_FPU_FLEN=64
CONFIG_FPU_PIPELINE=0
CONFIG_FPU_FMA=y
CONFIG_FPU_DIVSQRT=y
CONFIG_FPU_ROUNDING=y
CONFIG_FPU_FLAGS=y
CONFIG_FPU_HARDFLOAT_RECODE=y
# CONFIG_FPU_HARDFLOAT_TININESS_BEFORE_ROUNDING is not set

# Linux/U-Boot 已验证的缓存基线：ICache 打开、DCache 关闭。
# 需要数据缓存时在后续片段里显式覆盖 CONFIG_DCACHE=y。
CONFIG_ICACHE=y
CONFIG_DCACHE=n
CONFIG_CACHE_BLOCK_SIZE_LOG2=4
CONFIG_CACHE_INDEX_BITS=5
