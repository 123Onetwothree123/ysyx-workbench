# RV32 无 C 扩展负向回归：验证压缩编码在 RISCV_C=n 时明确触发
# illegal instruction(cause=2)，而不是被当作 32 位指令执行。
CONFIG_XLEN=32
CONFIG_RISCV_M=y
CONFIG_RISCV_A=n
CONFIG_RISCV_C=n
CONFIG_ICACHE=y
CONFIG_DCACHE=y
CONFIG_CACHE_BLOCK_SIZE_LOG2=4
CONFIG_CACHE_INDEX_BITS=4
CONFIG_ICACHE_STORAGE_REG=y
CONFIG_DCACHE_STORAGE_REG=y
CONFIG_SDB=n
CONFIG_TRACE=y
CONFIG_DIFFTEST=n
CONFIG_LOG_TO_FILE=n
CONFIG_PERF_STATS=n
CONFIG_PERF_SAVE=n
