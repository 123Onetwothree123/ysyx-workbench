# OpenSBI on NPC 的启动配置：RV64IMA + Sv39 + PMP + CLINT/PLIC/UART。
# OpenSBI 的 _start 使用 amoswap.w，故 RISCV_A 必须打开；
# 固件本身按无 F/D 的 rv64ima_zicsr_zifencei 编译（见构建脚本）。
# SBI_ENABLE 默认在通用 Kconfig 中为 n，本 defconfig 显式打开。
CONFIG_XLEN=64
CONFIG_RISCV_M=y
CONFIG_RISCV_A=y
# 固件按 rv64ima_zicsr_zifencei 编译，显式关闭 G 扩展的其余部分。
CONFIG_RISCV_C=n
CONFIG_RISCV_F=n
CONFIG_RISCV_D=n
CONFIG_HAS_S=y
CONFIG_HAS_U=y
CONFIG_HAS_MMU=y
CONFIG_HAS_TLB=y

CONFIG_MMU_PROFILE_BALANCED=y
CONFIG_MMU_GEOMETRY_STANDARD=y
CONFIG_MMU_GEOMETRY_MODE="standard"
CONFIG_MMU_CUSTOM_SATP_MODE=10
CONFIG_MMU_PAGE_SIZE_BYTES=4096
CONFIG_MMU_LEVELS=3
CONFIG_MMU_PTE_SIZE_BYTES=8
CONFIG_MMU_PAGE_TABLE_SIZE_BYTES=4096
CONFIG_MMU_PTE_RISCV64=y
CONFIG_MMU_PTE_FORMAT="riscv64"
CONFIG_MMU_SUPERPAGE=y
CONFIG_MMU_AD_FAULT=y
CONFIG_MMU_AD_MODE="fault"
CONFIG_MMU_CACHE_PIPT=y
CONFIG_MMU_CACHE_MODE="pipt"
CONFIG_MMU_PTW_DEDICATED=y
CONFIG_MMU_PTW_PATH="dedicated"
CONFIG_MMU_PTW_INDEPENDENT=y
CONFIG_MMU_PTW_ARCH="independent"
CONFIG_MMU_PTW_OUTSTANDING=2
CONFIG_MMU_PTW_BUS_OUTSTANDING=1
CONFIG_MMU_PTW_IN_ORDER=y
CONFIG_MMU_PTW_ORDER="in_order"
CONFIG_MMU_PTW_CACHE=n

CONFIG_TLB_SPLIT=y
CONFIG_TLB_ORGANIZATION="split"
CONFIG_TLB_STORAGE_REG=y
CONFIG_TLB_STORAGE="reg"
CONFIG_TLB_REPLACE_PLRU=y
CONFIG_TLB_REPLACEMENT="plru"
CONFIG_TLB_ASID_BITS=16
CONFIG_TLB_GLOBAL=y
CONFIG_ITLB_ENTRIES=16
CONFIG_ITLB_WAYS=2
CONFIG_DTLB_ENTRIES=32
CONFIG_DTLB_WAYS=4
CONFIG_TLB_SUPERPAGE=y
CONFIG_TLB_MISS_QUEUE_FOLLOW=y
CONFIG_TLB_MISS_QUEUE_MODE="follow_tlb"
CONFIG_ITLB_MISS_QUEUE_ENTRIES=4
CONFIG_DTLB_MISS_QUEUE_ENTRIES=4
CONFIG_TLB_REFILL_PORTS=1

CONFIG_HAS_S_TIMER_IRQ=y
CONFIG_HAS_S_EXTERNAL_IRQ=y
CONFIG_TIMER_CLINT_MTIP=y
CONFIG_TIMER_PATH="clint_mtip"
CONFIG_PLIC_SOURCES=32
CONFIG_PLIC_PRIORITY_BITS=3
CONFIG_PLIC_MAX_PRIORITY=7
CONFIG_PLIC_BASE=0x0c000000
CONFIG_HAS_PMP=y
CONFIG_PMP_ENTRIES=16

CONFIG_CSR_MISSING_ILLEGAL=y
CONFIG_CSR_MISSING_MODE="illegal"
CONFIG_CSR_VIEW_BOUND=y
CONFIG_CSR_VIEW_MODE="bound"
CONFIG_CSR_FIELD_DEFAULT_READ="normal"
CONFIG_CSR_FIELD_DEFAULT_WRITE="normal"

CONFIG_HAS_CSR_MSTATUS=y
CONFIG_HAS_CSR_MISA=y
CONFIG_HAS_CSR_MTVEC=y
CONFIG_HAS_CSR_MEPC=y
CONFIG_HAS_CSR_MCAUSE=y
CONFIG_HAS_CSR_MTVAL=y
CONFIG_HAS_CSR_MSCRATCH=y
CONFIG_HAS_CSR_MIE=y
CONFIG_HAS_CSR_MIP=y
CONFIG_HAS_CSR_MEDELEG=y
CONFIG_HAS_CSR_MIDELEG=y
CONFIG_HAS_CSR_MCOUNTEREN=y
CONFIG_HAS_CSR_MCOUNTINHIBIT=y
CONFIG_HAS_CSR_MCYCLE=y
CONFIG_HAS_CSR_MINSTRET=y
CONFIG_HAS_CSR_SSTATUS=y
CONFIG_HAS_CSR_SIE=y
CONFIG_HAS_CSR_SIP=y
CONFIG_HAS_CSR_STVEC=y
CONFIG_HAS_CSR_SSCRATCH=y
CONFIG_HAS_CSR_SEPC=y
CONFIG_HAS_CSR_SCAUSE=y
CONFIG_HAS_CSR_STVAL=y
CONFIG_HAS_CSR_SATP=y
CONFIG_HAS_CSR_SCOUNTEREN=y

# SBI 启动/调试：保留 SDB（--batch 需要），DiffTest 关闭以缩小构建。
# ftrace 会把 UART 逐字符输出与调用日志交错并显著拖慢启动，故默认关闭；
# 需要定位时再单独打开 CONFIG_TRACE/FTRACE/IRINGBUF。
# ICache 打开、DCache 关闭：沿用 xv6 已验证的最小组合；
# SBI 固件本身不依赖 D-cache。
CONFIG_ICACHE=y
CONFIG_DCACHE=n
CONFIG_SDB=y
CONFIG_TRACE=n
CONFIG_FTRACE=n
CONFIG_IRINGBUF=n
CONFIG_ITRACE=n
CONFIG_MTRACE=n
CONFIG_DIFFTEST=n
CONFIG_LOG_TO_FILE=n
CONFIG_PERF_STATS=n
CONFIG_PERF_SAVE=n

# M 模式 SBI 固件：OpenSBI NPC 平台。
# 默认布局：0x80000000 + 2 MiB 固件区，S 模式 next-stage 在 0x80200000。
CONFIG_SBI_ENABLE=y
CONFIG_SBI_IMPL_OPENSBI=y
CONFIG_SBI_IMPL="opensbi"
CONFIG_SBI_PLATFORM="npc"
CONFIG_SBI_FW_BASE=0x80000000
CONFIG_SBI_FW_SIZE=0x00200000
CONFIG_SBI_NEXT_ADDR=0x80200000
CONFIG_SBI_BUILD_JOBS=0

# 向 S 模式 next-stage 传递 DTB：Linux 需要 a1 指向有效的 FDT。
# 默认 0x80f00000 位于 0x80200000 next-stage 之后约 13 MiB；
# 若内核镜像更大，请同时调整 SBI_FDT_ADDR/SBI_NEXT_ADDR。
CONFIG_SBI_FDT_ENABLE=y
CONFIG_SBI_FDT_PATH="dts/npc.dts"
CONFIG_SBI_FDT_ADDR=0x80f00000
