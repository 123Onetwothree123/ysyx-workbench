menu "运行模式"
  choice
    prompt "目标运行模式"
    default NPC_MODE_YSYX_ONLY
    help
      FPGA 模式：只生成独立 FPGA 顶层，关闭一生一芯 Verilator 仿真，
      不依赖 ysyxSoC 的 APB、PSRAM、PMA 和板级外设。
      一生一芯模式：只保留 ysyxSoC Verilator 仿真，关闭 FPGA 部署。
      双模式：同时生成 ysyxSoC 仿真顶层和独立 FPGA 顶层，两套顶层
      互不依赖；不是在一个顶层里同时实例化两套 SoC。
    config NPC_MODE_FPGA_ONLY
      bool "FPGA 模式（关闭一生一芯仿真）"
    config NPC_MODE_YSYX_ONLY
      bool "一生一芯模式（关闭 FPGA）"
    config NPC_MODE_BOTH
      bool "FPGA + 一生一芯同时开启"
  endchoice
  config NPC_TARGET_MODE
    string
    default "fpga" if NPC_MODE_FPGA_ONLY
    default "ysyx" if NPC_MODE_YSYX_ONLY
    default "both" if NPC_MODE_BOTH
    default "ysyx"
  config NPC_BUILD_YSYXSOC
    bool
    default y if !NPC_MODE_FPGA_ONLY
  config NPC_BUILD_FPGA
    bool
    default y if NPC_MODE_FPGA_ONLY || NPC_MODE_BOTH
endmenu
