  "description": "RV32IMAC + Sv32 + OpenSBI + Linux 实验支持族：M/A/C=y、F/D=n、M/S/U、标准 Sv32（2 级、4 KiB 页、4 B PTE）、PMP 16 项、OpenSBI + FDT、直接 Linux 启动。SBI_NEXT_ADDR 固定 0x80400000（RV32 4 MiB 对齐）。DCache、initramfs 开关、64/128 MiB RAM 是有意支持的差异；RV32 Linux 尚无启动证据。",
  "id": "rv32imac-linux",
  "predicate": [
    {
      "description": "profile 只接受 RV32",
      "expr": {
        "eq": {
          "path": "isa.xlen",
          "value": 32
        }
      },
      "id": "xlen-32"
    },
    {
      "description": "profile 要求启用 MMU",
      "expr": {
        "eq": {
          "path": "mmu.enabled",
          "value": true
        }
      },
      "id": "mmu"
    },
    {
      "description": "只接受标准 MMU 几何；custom 几何属于 experimental",
      "expr": {
        "eq": {
          "path": "mmu.geometry_mode",
          "value": "standard"
        }
      },
      "id": "mmu-standard-geometry"
    },
    {
      "description": "标准 profile 固定 4 KiB 页",
      "expr": {
        "eq": {
          "path": "mmu.page_size_bytes",
          "value": 4096
        }
      },
      "id": "mmu-page-4k"
    },
    {
      "description": "标准 profile 使用 riscv32 PTE 格式",
      "expr": {
        "eq": {
          "path": "mmu.pte_format",
          "value": "riscv32"
        }
      },
      "id": "mmu-pte-format"
    },
    {
      "description": "标准 profile 使用 4 字节 PTE",
      "expr": {
        "eq": {
          "path": "mmu.pte_size_bytes",
          "value": 4
        }
      },
      "id": "mmu-pte-size"
    },
    {
      "description": "MMU 页表级数在标准 family 范围内",
      "expr": {
        "in": {
          "path": "mmu.levels",
          "values": [
            2
          ]
        }
      },
      "id": "mmu-levels"
    },
    {
      "description": "profile 要求 ISA.S=y",
      "expr": {
        "eq": {
          "path": "isa.s",
          "value": true
        }
      },
      "id": "isa-s-yes"
    },
    {
      "description": "profile 要求 ISA.U=y",
      "expr": {
        "eq": {
          "path": "isa.u",
          "value": true
        }
      },
      "id": "isa-u-yes"
    },
    {
      "description": "profile 要求 ISA.F=n",
      "expr": {
        "eq": {
          "path": "isa.f",
          "value": false
        }
      },
      "id": "isa-f-no"
    },
    {
      "description": "profile 要求 ISA.D=n",
      "expr": {
        "eq": {
          "path": "isa.d",
          "value": false
        }
      },
      "id": "isa-d-no"
    },
    {
      "description": "profile 要求 CONFIG_SBI_ENABLE=True",
      "expr": {
        "eq": {
          "path": "flat.SBI_ENABLE",
          "value": true
        }
      },
      "id": "flat-sbi-enable-yes"
    },
    {
      "description": "profile 要求 CONFIG_SBI_IMPL_OPENSBI=True",
      "expr": {
        "eq": {
          "path": "flat.SBI_IMPL_OPENSBI",
          "value": true
        }
      },
      "id": "flat-sbi-impl-opensbi-yes"
    },
    {
      "description": "profile 要求 CONFIG_SBI_FDT_ENABLE=True",
      "expr": {
        "eq": {
          "path": "flat.SBI_FDT_ENABLE",
          "value": true
        }
      },
      "id": "flat-sbi-fdt-enable-yes"
    },
    {
      "description": "profile 要求 CONFIG_LINUX_BOOT_ENABLE=True",
      "expr": {
        "eq": {
          "path": "flat.LINUX_BOOT_ENABLE",
          "value": true
        }
      },
      "id": "flat-linux-boot-enable-yes"
    },
    {
      "description": "profile 要求 CONFIG_NPC_UBOOT_ENABLE=False",
      "expr": {
        "eq": {
          "path": "flat.NPC_UBOOT_ENABLE",
          "value": false
        }
      },
      "id": "flat-npc-uboot-enable-no"
    },
    {
      "description": "profile 要求 CONFIG_HAS_PMP=True",
      "expr": {
        "eq": {
          "path": "flat.HAS_PMP",
          "value": true
        }
      },
      "id": "flat-has-pmp-yes"
    },
    {
      "description": "SoC AXI 侧保持 32 位",
      "expr": {
        "eq": {
          "path": "isa.soc_xlen",
          "value": 32
        }
      },
      "id": "soc-xlen-32"
    },
    {
      "description": "至少需要 64 MiB RAM",
      "expr": {
        "gte": {
          "path": "platform.ram_size",
          "value": 67108864
        }
      },
      "id": "ram-at-least-64m"
    },
    {
      "description": "当前 profile 只覆盖 ysyx 模式",
      "expr": {
        "not": {
          "eq": {
            "path": "flat.NPC_MODE_FPGA_ONLY",
            "value": true
          }
        }
      },
      "id": "ysyx-mode"
    }
  ],
