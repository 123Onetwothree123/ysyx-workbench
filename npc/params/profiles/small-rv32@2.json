  "description": "RV32 小型裸机支持族：RV32IM 基线，无 MMU。允许 A/C/F/D 扩展、硬浮点后端、S/U 与可选 machine CSR、PLIC 中断的开关；CPU XLEN、无 MMU、64 MiB RAM 与 ysyx 模式是硬边界。",
  "id": "small-rv32",
  "predicate": [
    {
      "description": "profile 只接受 RV32",
      "expr": {
        "eq": {
          "path": "isa.xlen",
          "value": 32
        }
      },
      "id": "xlen-32"
    },
    {
      "description": "裸机 profile 不带 MMU",
      "expr": {
        "eq": {
          "path": "mmu.enabled",
          "value": false
        }
      },
      "id": "no-mmu"
    },
    {
      "description": "RV32 小型平台 SoC AXI 侧保持 32 位",
      "expr": {
        "eq": {
          "path": "isa.soc_xlen",
          "value": 32
        }
      },
      "id": "soc-xlen-32"
    },
    {
      "description": "标准平台 RAM 为 64 MiB",
      "expr": {
        "eq": {
          "path": "platform.ram_size",
          "value": 67108864
        }
      },
      "id": "ram-64m"
    },
    {
      "description": "当前 profile 只覆盖 ysyx 模式",
      "expr": {
        "not": {
          "eq": {
            "path": "flat.NPC_MODE_FPGA_ONLY",
            "value": true
          }
        }
      },
      "id": "ysyx-mode"
    }
  ],
