  "description": "RV64 + OpenSBI 支持族：标准 Sv39 MMU、PMP、OpenSBI 固件，不直接启动 Linux/U-Boot。允许 FDT 与 PMU 开关及标准地址范围内的FDT 地址调整；Linux 启动、custom MMU 和 U-Boot 超出边界。",
  "id": "rv64-sbi",
  "predicate": [
    {
      "description": "profile 只接受 RV64",
      "expr": {
        "eq": {
          "path": "isa.xlen",
          "value": 64
        }
      },
      "id": "xlen-64"
    },
    {
      "description": "profile 要求启用 MMU",
      "expr": {
        "eq": {
          "path": "mmu.enabled",
          "value": true
        }
      },
      "id": "mmu"
    },
    {
      "description": "只接受标准 MMU 几何；custom 几何属于 experimental",
      "expr": {
        "eq": {
          "path": "mmu.geometry_mode",
          "value": "standard"
        }
      },
      "id": "mmu-standard-geometry"
    },
    {
      "description": "标准 profile 固定 4 KiB 页",
      "expr": {
        "eq": {
          "path": "mmu.page_size_bytes",
          "value": 4096
        }
      },
      "id": "mmu-page-4k"
    },
    {
      "description": "标准 profile 使用 riscv64 PTE 格式",
      "expr": {
        "eq": {
          "path": "mmu.pte_format",
          "value": "riscv64"
        }
      },
      "id": "mmu-pte-format"
    },
    {
      "description": "标准 profile 使用 8 字节 PTE",
      "expr": {
        "eq": {
          "path": "mmu.pte_size_bytes",
          "value": 8
        }
      },
      "id": "mmu-pte-size"
    },
    {
      "description": "MMU 页表级数在标准 family 范围内",
      "expr": {
        "in": {
          "path": "mmu.levels",
          "values": [
            3
          ]
        }
      },
      "id": "mmu-levels"
    },
    {
      "description": "标准平台 RAM 为 64 MiB",
      "expr": {
        "eq": {
          "path": "platform.ram_size",
          "value": 67108864
        }
      },
      "id": "ram-64m"
    },
    {
      "description": "OpenSBI 支持族要求 SBI 固件",
      "expr": {
        "eq": {
          "path": "flat.SBI_ENABLE",
          "value": true
        }
      },
      "id": "sbi"
    },
    {
      "description": "裸机 profile 不直接启动 Linux",
      "expr": {
        "eq": {
          "path": "flat.LINUX_BOOT_ENABLE",
          "value": false
        }
      },
      "id": "no-linux-boot"
    },
    {
      "description": "裸机 profile 不启用 U-Boot",
      "expr": {
        "eq": {
          "path": "flat.NPC_UBOOT_ENABLE",
          "value": false
        }
      },
      "id": "no-uboot"
    },
    {
      "description": "当前 profile 只覆盖 ysyx 模式",
      "expr": {
        "not": {
          "eq": {
            "path": "flat.NPC_MODE_FPGA_ONLY",
            "value": true
          }
        }
      },
      "id": "ysyx-mode"
    }
  ],
  "qualification": {
