mainmenu "NPC 测试选择"

choice
	prompt "默认测试层级"
	default TEST_TIER_FUNCTIONAL
	help
	  选择默认执行的测试层级；命令行 --tier 会覆盖这里。

config TEST_TIER_FUNCTIONAL
	bool "功能测试 functional"
config TEST_TIER_PERFORMANCE
	bool "性能测试 performance"
config TEST_TIER_ALL
	bool "全部 all"
endchoice

config TEST_TAG
	string "标签过滤 tag"
	default ""
	help
	  只跑带该 tag 的测试，空表示不过滤。
	  这里填英文 tag，例如 software、scala、bench。

config TEST_NAME
	string "名字过滤 name"
	default ""
	help
	  只跑名字包含该子串的测试，空表示不过滤。
	  这里填英文测试名片段，例如 PLIC、printf。

menu "目标平台"

choice
	prompt "ARCH"
	default TEST_ARCH_FOLLOW
	help
	  跟随模式下由 xlen.mk 按 CONFIG_XLEN 推导，和当前 NPC 配置一致。
	  自定义时填 abstract-machine/scripts/<ARCH>.mk 的文件名。

config TEST_ARCH_FOLLOW
	bool "跟随 NPC 配置 (CONFIG_XLEN)"
config TEST_ARCH_CUSTOM
	bool "自定义"
endchoice

config TEST_ARCH_CUSTOM_VALUE
	string "自定义 ARCH"
	depends on TEST_ARCH_CUSTOM
	default ""
	help
	  必须对应 abstract-machine/scripts/ 下的某个 .mk，例如 riscv64gc-npc。
	  运行时会按该目录校验，拼错会直接报错。

endmenu

config TEST_TIMEOUT_SCALE
	int "超时倍数 timeout scale"
	range 1 100
	default 1
	help
	  所有测试超时时间乘以该倍数。

config TEST_RETRY
	int "失败重试次数 retry (-1 = 沿用注册表)"
	range -1 10
	default -1
	help
	  失败后重试次数，-1 表示不覆盖注册表里的 retry。
	  命令行 --retry 会覆盖这里。
