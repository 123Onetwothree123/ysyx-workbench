mainmenu "NPC配置菜单"

# 顶层只做主题分组；具体选项在 kconfig/ 下的子文件里。
# 重排只移动 menu，不改变 CONFIG_* 符号名、默认值或依赖关系。

source "kconfig/Kconfig.hardware"   # CPU 与平台
source "kconfig/Kconfig.soc"        # SoC 与外设

menu "运行时与调试"
  source "kconfig/Kconfig.debug"    # 调试、追踪与性能
  source "kconfig/Kconfig.log"      # 日志
endmenu

menu "固件与启动"
  source "kconfig/Kconfig.sbi"
  source "kconfig/Kconfig.linux"
  source "kconfig/Kconfig.rootfs"
endmenu

source "kconfig/Kconfig.fpga"      # FPGA 部署

menu "构建与仿真"
  source "kconfig/Kconfig.cpp"      # 编译器与构建选项
  if !(FPGA_ENABLE && FPGA_SIM_EXCLUSIVE)
    source "kconfig/Kconfig.verilator"
  endif
  if FPGA_ENABLE && FPGA_SIM_EXCLUSIVE
    comment "FPGA 互斥模式：Verilator 仿真选项已关闭"
  endif
  source "kconfig/Kconfig.synth"
endmenu
