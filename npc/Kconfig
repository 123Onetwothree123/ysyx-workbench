mainmenu "NPC配置菜单"

# 拆分文件统一放在 kconfig/ 目录（整目录已在 .gitignore 白名单内），顶层
# 只保留 mainmenu 与 source；source 路径相对 npc/ 根目录解析。
source "kconfig/Kconfig.cpp"       # C++ 配置（工具链/语言标准/编译选项）
source "kconfig/Kconfig.log"       # 日志
source "kconfig/Kconfig.verilator" # Verilator 仿真
source "kconfig/Kconfig.hardware"  # 硬件配置（ISA/乘法器/缓存/外设）
source "kconfig/Kconfig.mmu"       # 虚存管理（MMU/TLB/CSR字段/中断）
source "kconfig/Kconfig.debug"     # 运行时调试（SDB/追踪/性能计数器）
source "kconfig/Kconfig.sbi"       # M 模式 SBI 固件（OpenSBI/RustSBI）
source "kconfig/Kconfig.synth"     # 综合 (Synthesis)
