menu "测试与调试"

config SDB
  bool "启用SDB调试器"
  default y

config PERF_STATS
  bool "启用性能统计（IPC/指令数/周期数）"
  default y
  help
    在仿真结束时输出动态指令数、周期数和IPC
    IPC = 指令数 / 周期数，反映处理器微结构效率
    开启后每周期读取debug_commit信号计数，开销极低

config PERF_SAVE
  bool "启用性能数据自动存档（TSV文件）"
  default y
  depends on PERF_STATS
  help
    仿真结束后自动把性能数据写入 NPCSimResult/ 目录
    每次运行生成时间戳命名的 .tsv 和 .log 文件
    同时追加到 perf.tsv 累计表格

config TRACE
  bool "启用追踪功能（总开关）"
  default n

config ITRACE
  bool "启用指令追踪itrace"
  default n
  depends on TRACE

config ITRACE_WRITE_FILE
  bool "itrace 输出到文件 (itrace.txt)"
  default n
  depends on ITRACE

config MTRACE
  bool "启用内存追踪mtrace"
  default n
  depends on TRACE

config FTRACE
  bool "启用函数调用追踪ftrace"
  default n
  depends on TRACE

config IRINGBUF
  bool "启用指令环形缓冲区iringbuf"
  default n
  depends on TRACE
  help
    在环形缓冲区中记录最近执行的指令，并在NPC异常终止时输出

config IRINGBUF_SIZE
  int "指令环形缓冲区大小"
  default 16
  depends on IRINGBUF

config WATCHPOINT
  bool "启用监视点"
  default n
  help
    启用监视点功能，用于监控表达式值的变化

config DIFFTEST
  bool "启用差分测试difftest"
  default n
  help
    启用差分测试，并使用NEMU作为参考模型
    需要将NEMU编译为.so共享库
    使用make run diff=/path/to/nemu-so指定参考模型

