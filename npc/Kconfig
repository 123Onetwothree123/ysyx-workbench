mainmenu "NPC配置菜单"

menu "编译器/C++选项"

choice
  prompt "编译器"
  default CC_GPP
config CC_GPP
  bool "g++"
config CC_CLANG
  bool "clang++"
endchoice

config CC
  string
  default "g++" if CC_GPP
  default "clang++" if CC_CLANG
  default "g++"

choice
  prompt "C++标准库"
  default STDLIB_LIBSTDCXX
  help
    选择C++标准库实现
    Clang支持在libstdc++与libc++之间自由切换
    GCC的-fmodules实现硬编码了libstdc++的模块映射器路径
    即使手动指向libc++头文件，GCC仍会将标准库include
    重定向到libstdc++的bits/stdc++.h模块基础设施
    因此选择libc++时此选项仅对Clang生效
    本人补充：日你妈理查德·斯托曼，浪费了我一个下午的时间
config STDLIB_LIBSTDCXX
  bool "libstdc++（GNU）"
config STDLIB_LIBCXX
  bool "libc++（LLVM）"
endchoice

config STDLIB_FLAG
  string
  default "-stdlib=libstdc++" if STDLIB_LIBSTDCXX
  default "-stdlib=libc++" if STDLIB_LIBCXX
  default "-stdlib=libstdc++"

choice
  prompt "C库"
  default LIBC_GLIBC
  help
    C运行库实现，位于C++标准库下层，提供printf/malloc/pthread等
    musl：Arch的libstdc++和libc++均基于glibc编译，运行时依赖
    glibc特有符号（__vfprintf_chk、__isoc23_*等），musl不提供
    需要Alpine Linux等基于musl构建整套C++工具链的发行版才能用
    LLVM libc：未完成，无Arch包，不可用
    当前仅glibc可用
config LIBC_GLIBC
  bool "glibc（GNU）"
endchoice

choice
  prompt "用户C++语言标准"
  default USER_CXX_STD_CXX23
  help
    设置csrc目录中用户C++源码使用的语言标准
    用户源码依赖std::print等特性，最低要求C++23
config USER_CXX_STD_CXX23
  bool "C++23"
config USER_CXX_STD_CXX26
  bool "C++26"
endchoice

config USER_CXX_STD
  string
  default "c++23" if USER_CXX_STD_CXX23
  default "c++26" if USER_CXX_STD_CXX26
  default "c++23"

choice
  prompt "Verilator生成代码语言标准"
  default VERILATOR_CXX_STD_CXX20
  help
    设置Verilator运行库、预编译头和生成模型使用的语言标准
    Verilator生成代码不依赖高版本特性，可使用较低标准
config VERILATOR_CXX_STD_CXX17
  bool "C++17"
config VERILATOR_CXX_STD_CXX20
  bool "C++20"
config VERILATOR_CXX_STD_CXX23
  bool "C++23"
endchoice

config VERILATOR_CXX_STD
  string
  default "c++17" if VERILATOR_CXX_STD_CXX17
  default "c++20" if VERILATOR_CXX_STD_CXX20
  default "c++23" if VERILATOR_CXX_STD_CXX23
  default "c++20"

choice
  prompt "优化级别"
  default CC_O3
config CC_O0
  bool "O0"
config CC_O1
  bool "O1"
config CC_O2
  bool "O2"
config CC_O3
  bool "O3"
config CC_OFAST
  bool "Ofast"
  help
    等同于-O3加上-ffast-math
    放宽IEEE浮点标准合规性换取速度
    可能导致浮点计算结果与标准不一致
endchoice

config CC_OPT
  string
  default "-O0" if CC_O0
  default "-O1" if CC_O1
  default "-O2" if CC_O2
  default "-O3" if CC_O3
  default "-Ofast" if CC_OFAST
  default "-O3"

choice
  prompt "链接器"
  default LD_DEFAULT
  help
    GCC和Clang均支持切换链接器
config LD_DEFAULT
  bool "ld（GNU）"
config LD_GOLD
  bool "gold（GNU）"
  help
    GNU gold链接器，比ld快2-4倍
    GCC/Clang通过-fuse-ld=gold使用
config LD_LLD
  bool "lld（LLVM）"
  help
    LLVM链接器，比ld快5-10倍
config LD_MOLD
  bool "mold"
  help
    最快的链接器，比ld快10-20倍
endchoice

config LD_FLAG
  string
  default "" if LD_DEFAULT
  default "-fuse-ld=gold" if LD_GOLD
  default "-fuse-ld=lld" if LD_LLD
  default "-fuse-ld=mold" if LD_MOLD
  default ""

config CC_LTO
  bool "启用链接时优化-flto"
  default n

choice
  prompt "PGO配置引导优化"
  default PGO_OFF
  help
    使用方法：先选生成模式编译运行，再选使用模式重新编译
    1. 选"生成"→编译→运行典型工作负载→产生.gcda/.profraw
    2. 选"使用"→重新编译→编译器根据profile数据优化
config PGO_OFF
  bool "关闭"
config PGO_GENERATE
  bool "生成profile数据"
config PGO_USE
  bool "使用profile数据优化"
endchoice

config CC_DEBUG
  bool "生成调试信息-g"
  default n

config CC_ASAN
  bool "启用ASan地址错误检测-fsanitize=address"
  default n

config CC_UBSAN
  bool "启用UBSan未定义行为检测-fsanitize=undefined"
  default n

config CC_TSAN
  bool "启用TSan线程竞争检测-fsanitize=thread"
  default n
  help
    检测数据竞争，不能与ASan同时使用

config CC_WALL
  bool "启用额外警告-Wall -Wextra"
  default n

config CC_WERROR
  bool "将警告视为错误-Werror"
  default n

config CC_NO_OMIT_FP
  bool "保留帧指针-fno-omit-frame-pointer"
  default n


endmenu

menu "Verilator选项"

config BUILD_THREADS
  int "构建线程数，0 = 使用全部核心"
  default 0
  help
    设置Verilator并行构建的线程数
    0表示使用所有可用核心
    超过系统核心数的值将被限制为系统核心数

config SIM_THREADS
  int "仿真线程数，0 = 全部核心，1 = 单线程"
  default 1
  help
    设置Verilator运行仿真时使用的线程数
    0表示使用所有可用核心
    1表示单线程，这是默认值，也是最稳妥的选择
    超过系统核心数的值将被限制为系统核心数
    由于存在线程同步开销，多线程仿真不一定更快

choice
  prompt "波形追踪"
  default TRACE_NONE
config TRACE_NONE
  bool "不生成波形"
config TRACE_VCD
  bool "VCD --trace"
config TRACE_FST
  bool "FST --trace-fst"
endchoice

config TRACE_DEPTH
  int "波形追踪深度，0 = 全部层级"
  default 0
  depends on !TRACE_NONE
  help
    设置Verilator波形追踪的--trace-depth层级
    0表示追踪所有层级

choice
  prompt "Verilator优化级别"
  default VERILATOR_O3
config VERILATOR_O0
  bool "O0"
config VERILATOR_O1
  bool "O1"
config VERILATOR_O2
  bool "O2"
config VERILATOR_O3
  bool "O3"
endchoice

config VERILATOR_OPT
  string
  default "-O0" if VERILATOR_O0
  default "-O1" if VERILATOR_O1
  default "-O2" if VERILATOR_O2
  default "-O3" if VERILATOR_O3
  default "-O3"

config PROF_CFUNCS
  bool "启用性能分析--prof-cfuncs"
  default n

config AUTOFLUSH
  bool "启用自动刷新--autoflush"
  default y
  help
    每个周期结束后自动刷新输出流
    禁用此项可能提升性能，但如果仿真崩溃，波形可能不完整

config ASSERT
  bool "启用SystemVerilog断言--assert"
  default n
  help
    启用RTL设计中的SVA断言
    为提高性能，默认使用--noassert

choice
  prompt "X赋值模式--x-assign"
  default X_ASSIGN_FAST
config X_ASSIGN_FAST
  bool "fast"
config X_ASSIGN_0
  bool "0"
config X_ASSIGN_1
  bool "1"
config X_ASSIGN_UNIQUE
  bool "unique"
endchoice

choice
  prompt "X初始值模式--x-initial"
  default X_INITIAL_FAST
config X_INITIAL_FAST
  bool "fast"
config X_INITIAL_0
  bool "0"
config X_INITIAL_1
  bool "1"
config X_INITIAL_UNIQUE
  bool "unique"
endchoice

config COVERAGE
  bool "启用RTL覆盖率统计--coverage"
  default n

endmenu

menu "测试与调试"

config SDB
  bool "启用SDB调试器"
  default y

config TRACE
  bool "启用追踪功能（总开关）"
  default n

config ITRACE
  bool "启用指令追踪itrace"
  default n
  depends on TRACE

config MTRACE
  bool "启用内存追踪mtrace"
  default n
  depends on TRACE

config FTRACE
  bool "启用函数调用追踪ftrace"
  default n
  depends on TRACE

config IRINGBUF
  bool "启用指令环形缓冲区iringbuf"
  default n
  depends on TRACE
  help
    在环形缓冲区中记录最近执行的指令，并在NPC异常终止时输出

config IRINGBUF_SIZE
  int "指令环形缓冲区大小"
  default 16
  depends on IRINGBUF

config WATCHPOINT
  bool "启用监视点"
  default n
  help
    启用监视点功能，用于监控表达式值的变化

config DIFFTEST
  bool "启用差分测试difftest"
  default n
  help
    启用差分测试，并使用NEMU作为参考模型
    需要将NEMU编译为.so共享库
    使用make run diff=/path/to/nemu-so指定参考模型

endmenu

menu "目标体系结构"

config MBASE
  hex "内存基地址"
  default 0x20000000
  help
    加载程序镜像的内存区域基地址

config MSIZE
  hex "内存大小"
  default 0x1000
  help
    内存区域的大小，单位为字节

config RESET_PC
  hex "复位PC地址"
  default 0x20000000
  help
    复位后程序计数器的初始值

endmenu
