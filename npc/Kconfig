# Stable NPC Kconfig entry point.
#
# The parameter schema is the authority:
#   npc/params/schema/schema.json
#
# `make menuconfig`, `make <name>_defconfig`, `make profile-defconfig` and
# `make npc-config` regenerate `params/generated/` from the schema before the
# Kconfig parser runs.  Do not add symbols here; add them to the schema and
# regenerate the Kconfig tree.
#
# Kconfig only accepts `mainmenu` in the top-level file, so the title stays in
# this wrapper while every symbol/menu lives in the generated tree.
mainmenu "NPC配置菜单"

source "params/generated/Kconfig"
