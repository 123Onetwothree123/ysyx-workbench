!log/
!log/**/*
!*.csv

# Yosys/iSTA result netlists are reproducible and are not versioned
/yosys-sta-result/**/*.v
/yosys-sta-result/**/*.v.sim

# GCC C++ modules cache (build artifact)
gcm.cache/



# RustSBI 固件源码、测试与文档（vendor 源码在根 .gitignore 单独放行）
!/rustsbi-fw/
!/rustsbi-fw/**/*
/rustsbi-fw/target/
# NPC 设备树源文件（生成的 DTB 在 build/ 下，不跟踪）
!/dts/
!/dts/**/*

# 检查点/实验构建目录不纳入版本管理
/build-*/**
/checkpoints/
