build/
include/config/
include/generated/npc_config.json
# C++ 配置模块生成目录（由 .config 派生，不纳入版本管理）
/csrc/generated/

# mill
!*.mill
!.mill-version
out/
.bsp/
.idea/
.idea_modules/
test_run_dir/

# 性能记录需要纳入版本管理
!NPCSimResult/
