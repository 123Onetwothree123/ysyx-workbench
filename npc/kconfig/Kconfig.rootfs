menu "根文件系统 (rootfs)"

  config ROOTFS_ENABLE
    bool "启用 rootfs"
    default n
    help
      启用后，make rootfs 会使用下面选择的 rootfs 实现生成
      initramfs 镜像；关闭时 make rootfs 会明确报错。该开关只
      负责 rootfs 前道工序，Linux kernel 仍由用户自行下载、
      编译和启动，本构建不会联网或构建内核。

  choice
    prompt "rootfs 实现"
    depends on ROOTFS_ENABLE
    default ROOTFS_BUSYBOX

    config ROOTFS_BUSYBOX
      bool "BusyBox"
      help
        使用 vendor/busybox 中的 BusyBox 源码构建最小 rootfs。
        当前只提供这一种实现；后续新增实现必须在此 choice 中
        显式增加，不能静默回退到 BusyBox。
  endchoice

  config ROOTFS_TYPE
    string
    default "busybox" if ROOTFS_BUSYBOX
    default "none"
    help
      当前生效的 rootfs 类型。ROOTFS_ENABLE=n 时为 none；
      启用后只能选择已实现的 BusyBox。

  config ROOTFS_BUSYBOX_PATH
    string "BusyBox 源码路径"
    depends on ROOTFS_BUSYBOX
    default "vendor/busybox"
    help
      BusyBox 源码目录，相对路径按 ysyx-workbench 根目录解析。
      当前树内版本为 BusyBox 1.36.1，源码随仓库跟踪，不使用
      git submodule，也不在构建时联网下载。

  config ROOTFS_BUSYBOX_VERSION
    string "BusyBox 版本"
    depends on ROOTFS_BUSYBOX
    default "1.36.1"
    help
      仅用于记录和检查树内 BusyBox 源码版本。版本变化时必须
      同时更新 vendor/busybox 源码和校验信息。

  config ROOTFS_BUSYBOX_TOOLCHAIN_PREFIX
    string "BusyBox 交叉工具链前缀"
    depends on ROOTFS_BUSYBOX
    default "riscv64-linux-gnu-"
    help
      编译 BusyBox 使用的工具链前缀。构建脚本要求
      <前缀>gcc 存在，且 -dumpmachine 的目标为 riscv64；
      不满足时明确报错。可用同名环境变量覆盖。

  config ROOTFS_BUSYBOX_MARCH
    string "BusyBox -march"
    depends on ROOTFS_BUSYBOX
    default "rv64gc"
    help
      传给 BusyBox 编译器的 -march。默认 rv64gc，覆盖
      RV64GC（含 F/D 与压缩指令）。可用同名环境变量覆盖。

  config ROOTFS_BUSYBOX_MABI
    string "BusyBox -mabi"
    depends on ROOTFS_BUSYBOX
    default "lp64d"
    help
      传给 BusyBox 编译器的 -mabi。默认 lp64d，与 rv64gc
      的硬件浮点调用约定一致。可用同名环境变量覆盖。

  config ROOTFS_BUSYBOX_STATIC
    bool "静态链接 BusyBox"
    depends on ROOTFS_BUSYBOX
    default y
    help
      最小 initramfs 只包含 BusyBox 本身，因此必须静态链接。
      当前构建脚本只支持 y；设为 n 会明确报错，而不会生成
      缺少动态加载器和 libc 的不可启动镜像。

  config ROOTFS_FASTFETCH
    bool "安装 fastfetch"
    depends on ROOTFS_BUSYBOX
    default y
    help
      将静态链接的 RV64GC/lp64d fastfetch 安装到 rootfs 的
      /usr/bin/fastfetch。目标二进制不存在时，构建脚本会调用
      npc/scripts/build_fastfetch.sh 自动交叉编译。

  config ROOTFS_FASTFETCH_PATH
    string "fastfetch 二进制路径"
    depends on ROOTFS_FASTFETCH
    default "build/fastfetch/fastfetch"
    help
      fastfetch 二进制路径。相对路径按 npc/ 解析；默认使用
      npc/scripts/build_fastfetch.sh 的输出。也可指向预先构建
      好的静态 RV64GC/lp64d 二进制。构建脚本会校验 ELF64
      RISC-V、RVC、double-float ABI 和静态链接。

  config ROOTFS_BUSYBOX_INIT_SCRIPT
    bool "生成 BusyBox sh /init 脚本"
    depends on ROOTFS_BUSYBOX
    default y
    help
      启用时生成 /init：用 BusyBox sh 挂载 proc/sys（失败不
      致命）、创建 /dev/console，最后 exec /bin/sh。
      关闭时不生成 /init，改为 /sbin/init -> BusyBox init 和
      最小 /etc/inittab，由内核回退到 /sbin/init。

  config ROOTFS_BUSYBOX_APPLETS
    string "BusyBox applet 符号链接"
    depends on ROOTFS_BUSYBOX
    default "sh ls cat echo mount umount mkdir mknod ps kill sleep dmesg ifconfig ip vi grep sed awk find cp mv rm ln chmod chown df du free uname hostname reboot poweroff halt switch_root mdev insmod lsmod rmmod modprobe tar gzip gunzip wc head tail sort uniq tr cut printf test true false date id whoami env pwd touch sync init"
    help
      以空格分隔的 applet 名称，构建脚本在 rootfs 的 /bin 下
      为它们创建指向 busybox 的相对符号链接。每个名称必须是
      当前 BusyBox 配置实际启用的 applet，否则构建明确失败。
      至少需要包含 sh（/init 的交互 shell）。

  config ROOTFS_BUSYBOX_JOBS
    int "BusyBox 并行任务数"
    depends on ROOTFS_BUSYBOX
    default 0
    range 0 256
    help
      BusyBox 的 make -j 数量。0 表示使用 nproc（上限 256）。
      可用同名环境变量覆盖。

  config ROOTFS_OUT_DIR
    string "rootfs 输出目录"
    depends on ROOTFS_ENABLE
    default "build/rootfs"
    help
      相对路径按 npc/ 解析；默认在 npc/build/rootfs 下存放
      BusyBox out-of-tree 构建目录、rootfs 树和 initramfs。
      可用同名环境变量覆盖。

endmenu
