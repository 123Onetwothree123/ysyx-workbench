menu "仿真后端"

  choice
    prompt "RTL 仿真器"
    default SIM_BACKEND_VERILATOR
    help
      Verilator：完整的 ysyxSoC/direct-NPC 仿真流程。
      GSIM：OpenXiangShan 的 chirrtl 仿真器，直接消费 direct-NPC
      SimTop 的 CHIRRTL，由 make gsim 生成并编译 C++ harness。
    config SIM_BACKEND_VERILATOR
      bool "Verilator"
    config SIM_BACKEND_GSIM
      bool "GSIM（chirrtl）"
  endchoice

  config SIM_BACKEND
    string
    default "verilator" if SIM_BACKEND_VERILATOR
    default "gsim" if SIM_BACKEND_GSIM
    default "verilator"

  if SIM_BACKEND_GSIM
    config GSIM_COMMAND
      string "gsim 可执行文件"
      default "gsim"
      help
        GSIM 编译器路径。默认从 PATH 查找 gsim。

    config GSIM_EXTRA_ARGS
      string "gsim 额外参数"
      default ""
      help
        追加到 gsim 命令行的参数，例如 --log-level=1。
  endif

endmenu
