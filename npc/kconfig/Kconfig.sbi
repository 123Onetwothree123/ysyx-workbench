menu "SBI 固件"

  config SBI_ENABLE
    bool "启用 SBI 固件"
    default n
    help
      启用后，NPC 可加载 M 模式 SBI 固件，再跳转到 S 模式
      next-stage（例如 Linux）。默认关闭，xv6 仍按 M 模式直接启动。

      当前提供 OpenSBI 与 RustSBI 两个实现选项；未构建对应固件时，
      构建脚本会明确报错，不会静默使用其他实现。

  choice
    prompt "SBI 实现"
    depends on SBI_ENABLE
    default SBI_IMPL_OPENSBI

    config SBI_IMPL_OPENSBI
      bool "OpenSBI"
      help
        使用 vendor/opensbi 中的 OpenSBI 固件。

    config SBI_IMPL_RUSTSBI
      bool "RustSBI"
      help
        使用 vendor/rustsbi 中的 RustSBI 固件。
        需要 rustup 的 RISC-V bare-metal target；构建脚本会在缺失时明确报错。
  endchoice

  config SBI_IMPL
    string
    default "opensbi" if SBI_IMPL_OPENSBI
    default "rustsbi" if SBI_IMPL_RUSTSBI
    default "none"

  config SBI_FW_BASE
    hex "SBI 固件加载地址"
    default 0x80000000
    help
      SBI 固件的 M 模式入口/加载地址。必须与 NPC reset PC 和
      next-stage 布局一致。

  config SBI_FW_SIZE
    hex "SBI 固件最大大小"
    default 0x00200000
    help
      为 SBI 固件预留的地址空间大小。next-stage 必须位于
      SBI_FW_BASE + SBI_FW_SIZE 之后，除非显式覆盖 SBI_NEXT_ADDR。

  config SBI_NEXT_ADDR
    hex "SBI 跳转的 next-stage 地址"
    default 0x80200000
    help
      OpenSBI/RustSBI 启动完成后跳转到的 S 模式入口。
      Linux 通常放在 0x80200000 附近；具体以镜像链接地址为准。

  config SBI_PLATFORM
    string "SBI 平台名"
    default "npc"
    help
      SBI 固件的平台适配名。当前为 NPC 最小平台：
      UART 0x10000000、CLINT 0x02000000、PLIC 0x0c000000、RAM 0x80000000。

  config SBI_BUILD_JOBS
    int "SBI 构建并行度"
    default 0
    help
      传给 SBI 构建脚本的并行任务数；0 表示使用当前 CPU 核数。

  config SBI_FDT_ENABLE
    bool "向 next-stage 传递设备树 (DTB)"
    depends on SBI_ENABLE
    default n
    help
      打开后，SBI 固件会内嵌 npc/dts/npc.dts 生成的 DTB，并在进入
      S 模式时把它放到 SBI_FDT_ADDR，通过 a1 传给 next-stage
      （Linux 约定 a1=DTB 物理地址）。

      默认关闭：SBI 仍按编译期固定的平台设备初始化，进入 S 模式时
      a1=0，和之前的 OpenSBI/RustSBI 行为完全一致。

  config SBI_FDT_PATH
    string "设备树源文件/二进制路径"
    depends on SBI_FDT_ENABLE
    default "dts/npc.dts"
    help
      DTS 或 DTB 文件。相对路径按 npc/ 目录解析；也可以写绝对路径。
      .dts 会先经 cpp 展开布局宏，再由 dtc 编译；.dtb 直接使用。

      默认的 npc/dts/npc.dts 会读取 SBI_FW_BASE/SBI_FW_SIZE/
      SBI_NEXT_ADDR/SBI_FDT_ADDR，使 reserved-memory 与实际 SBI
      布局一致。

  config SBI_FDT_ADDR
    hex "DTB 加载/传递地址"
    depends on SBI_FDT_ENABLE
    default 0x80f00000
    help
      DTB 在物理内存中的最终地址。OpenSBI 通过 FW_JUMP_FDT_ADDR/
      FW_PAYLOAD_FDT_ADDR 把内嵌 DTB 复制到这里；RustSBI 也会把
      内嵌 DTB 复制到这里，再以 a1 传给 S 模式。

      该地址必须 8 字节对齐，位于 NPC RAM 内，且不能与 SBI 固件区
      重叠。默认 0x80f00000 位于 next-stage 0x80200000 之后，给
      Linux Image 预留约 13 MiB；如果内核更大，请同时上移
      SBI_FDT_ADDR 或下移 SBI_NEXT_ADDR。

endmenu
