menu "调试、追踪与性能"

  config SDB
    bool "启用SDB调试器"
    default y

  config PERF_DIC_ARCH_COUNTER
    bool "数字集成电路计算机体系结构性能计数器"
    default y
    help
      实现相关的体系结构性能计数器。可通过仿真、FPGA、MMIO
      或流片后的片内调试接口采集，不属于 RISC-V 标准 PMU。
      当前 Verilator 后端在仿真结束时输出动态指令数、周期数、
      IPC 以及下方各分组计数器。
      具体计数器的分组与单计数器选择见下方细分菜单：
      未开启的计数器在RTL顶层输出常量，综合展平后不会产生硬件；
      当前 C++ 采集后端也不再逐拍采样，对应 CSV 列恒为 0。

  menu "数字集成电路计算机体系结构性能计数器：细分"

    config PERF_DIC_ARCH_COUNTER_BASIC
      bool "基础吞吐组：取指交付/执行完成/读写完成"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关：关闭时本组下所有单计数器同时关闭。
        单计数器开关见本组子菜单"基础吞吐：单计数器"。

    config PERF_DIC_ARCH_COUNTER_OPCLASS
      bool "指令类型与执行活跃组：ALU/访存/CSR/分支/JAL/JALR"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关：关闭时本组下所有单计数器同时关闭。
        单计数器开关见本组子菜单"指令类型与执行活跃：单计数器"。

    config PERF_DIC_ARCH_COUNTER_MDU
      bool "乘除法组：请求/完成/操作码/活动与等待"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关。仅在RISCV_M开启时有意义；单计数器见本组子菜单。

    config PERF_DIC_ARCH_COUNTER_IFU_STALL
      bool "取指停顿组：流水/总线/AR/R/重定向/空闲"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。

    config PERF_DIC_ARCH_COUNTER_ICACHE
      bool "指令缓存组：命中/缺失"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。关闭后CSV的ICache命中/
        缺失/平均缺失服务周期/AMAT列恒为0。

    config PERF_DIC_ARCH_COUNTER_DCACHE
      bool "数据缓存组：命中/缺失/回填请求/回填响应"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。DCache本身未开启时这些列恒为0。

    config PERF_DIC_ARCH_COUNTER_EXU_STALL
      bool "执行级停顿组：下游等待/空转/等待槽"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。

    config PERF_DIC_ARCH_COUNTER_LSU
      bool "访存级组：活跃状态与读写停顿"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。

    config PERF_DIC_ARCH_COUNTER_IDU_STALL
      bool "译码级RAW停顿组：总数/load-use/其它"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。

    config PERF_DIC_ARCH_COUNTER_TRAP
      bool "异常组：提交次数"
      depends on PERF_DIC_ARCH_COUNTER
      default y
      help
        组总开关；单计数器见本组子菜单。

    config PERF_DIC_ARCH_COUNTER_BRANCH_PRED
      bool "分支预测组：BTB/JAL-BTB/RAS 命中与误预测"
