        bool "DCache 行填充完成（perf_dcache_line_fill）"
        default y

      config PERF_DIC_ARCH_COUNTER_DCACHE_WRITEBACK
        bool "DCache 写直达/store 行更新（perf_dcache_writeback）"
        default y
    endmenu

    menu "中断：单计数器"
      depends on PERF_DIC_ARCH_COUNTER_INTERRUPT

      config PERF_DIC_ARCH_COUNTER_TIMER_IRQ
        bool "定时器中断（perf_timer_irq）"
        default y

      config PERF_DIC_ARCH_COUNTER_EXTERNAL_IRQ
        bool "外部中断（perf_external_irq）"
        default y

      config PERF_DIC_ARCH_COUNTER_INTERRUPT_TAKEN
        bool "实际进入中断（perf_interrupt_taken）"
        default y

      config PERF_DIC_ARCH_COUNTER_PLIC_CLAIM
        bool "PLIC claim（perf_plic_claim）"
        default y

      config PERF_DIC_ARCH_COUNTER_PLIC_COMPLETE
        bool "PLIC complete（perf_plic_complete）"
        default y

      config PERF_DIC_ARCH_COUNTER_INTERRUPT_PENDING_CYCLE
        bool "中断 pending 周期数（perf_irq_pending）"
        default y

      config PERF_DIC_ARCH_COUNTER_INTERRUPT_LATENCY
        bool "中断 pending 到 trap 入口的延迟统计（perf_irq_pending）"
        default y
    endmenu

    menu "写缓冲：单计数器"
      depends on PERF_DIC_ARCH_COUNTER_WBUF

      config PERF_DIC_ARCH_COUNTER_WBUF_FULL
        bool "写缓冲无空位（perf_wbuf_full）"
        default y

      config PERF_DIC_ARCH_COUNTER_WBUF_DRAIN
        bool "写响应在途/排空（perf_wbuf_drain）"
        default y

      config PERF_DIC_ARCH_COUNTER_WBUF_OCCUPANCY
        bool "写缓冲占用周期和（perf_wbuf_count）"
        default y
    endmenu

    menu "CSR：单计数器"
      depends on PERF_DIC_ARCH_COUNTER_CSR

      config PERF_DIC_ARCH_COUNTER_CSR_READ
        bool "CSR读（perf_csr_read）"
        default y

      config PERF_DIC_ARCH_COUNTER_CSR_WRITE
        bool "CSR写（perf_csr_write）"
        default y

      config PERF_DIC_ARCH_COUNTER_CSR_ILLEGAL
        bool "非法 CSR 指令（perf_csr_illegal）"
        default y
    endmenu

    menu "MDU 细节：单计数器"
      depends on PERF_DIC_ARCH_COUNTER_MDU_DETAIL

      config PERF_DIC_ARCH_COUNTER_MUL_ACTIVE
        bool "乘法活跃周期（perf_mul_active）"
        default y

      config PERF_DIC_ARCH_COUNTER_DIV_ACTIVE
        bool "除法活跃周期（perf_div_active）"
        default y

      config PERF_DIC_ARCH_COUNTER_DIV_ITERATIONS
        bool "除法实际迭代位数（perf_div_iterations）"
        default y

      config PERF_DIC_ARCH_COUNTER_DIV_EARLY_OUT
        bool "除法提前结束次数（perf_div_early_out）"
        default y
    endmenu

    menu "队列/气泡：单计数器"
      depends on PERF_DIC_ARCH_COUNTER_QUEUE

      config PERF_DIC_ARCH_COUNTER_ISSUE_OCCUPANCY
        bool "EXU输入槽占用周期（perf_issue_occupancy）"
        default y

      config PERF_DIC_ARCH_COUNTER_RETIRE_OCCUPANCY
        bool "EXU输出/退休槽占用周期（perf_retire_occupancy）"
        default y

      config PERF_DIC_ARCH_COUNTER_BUBBLE_CYCLE
        bool "EXU输入气泡周期（perf_bubble_cycle）"
        default y
    endmenu

  endmenu

  config PERF_RISCV_ARCH_PMU
    bool "第五代精简指令集标准架构性能监测单元"
    default n
    help
      RISC-V 标准架构性能监测单元（PMU）。打开后生成 Zihpm
      可编程计数器、mhpmevent 事件选择器，并按子选项生成
      Sscofpmf 溢出/模式过滤逻辑。

  menu "第五代精简指令集标准架构性能监测单元：细分"
    depends on PERF_RISCV_ARCH_PMU

    config PERF_RISCV_ARCH_PMU_ZIHPM
      bool "Zihpm：mhpmcounter3..31 / mhpmevent3..31"
      default y
      help
        29 个 64 位可编程硬件性能计数器及对应事件选择器。

    config PERF_RISCV_ARCH_PMU_SSCOFPMF
      bool "Sscofpmf：计数溢出与模式过滤"
      default y
      depends on PERF_RISCV_ARCH_PMU_ZIHPM
      help
        标准可选扩展 Sscofpmf，包括 scountovf、LCOFI 以及
        mhpmevent 的 OF/MINH/SINH/UINH 过滤位。
  endmenu

  config PERF_SAVE
    bool "启用性能数据自动存档（CSV文件）"
    default y
    depends on PERF_DIC_ARCH_COUNTER
    help
      仿真结束后把本次性能数据写入单独的 CSV 文件。
      默认保存到 NPCSimResult/YYYYMMDD-HHMMSS/ 目录；同一秒
      内的多次运行会加数字后缀，不会覆盖已有结果。命令行
      --result-dir 可指定其他目录；未启用本选项时传入该参数
      会明确报错，不会静默忽略。
      CSV 同时记录工作区 dirty 状态、有效硬件配置摘要/哈希和
      当前目标 RTL 哈希。只有 target、PDK、配置及 RTL 哈希都匹配
      时才采用 synth.txt 的频率和面积，避免普通运行误用旧综合结果。

  config TRACE
    bool "启用追踪功能（总开关）"
    default n

  config ITRACE
    bool "启用指令追踪itrace"
    default n
    depends on TRACE

  config ITRACE_WRITE_FILE
    bool "itrace 输出到文件 (itrace.txt)"
    default n
    depends on ITRACE

  config MTRACE
    bool "启用内存追踪mtrace"
    default n
    depends on TRACE

  config FTRACE
    bool "启用函数调用追踪ftrace"
    default n
    depends on TRACE

  config IRINGBUF
    bool "启用指令环形缓冲区iringbuf"
    default n
    depends on TRACE
    help
      在环形缓冲区中记录最近执行的指令，并在NPC异常终止时输出

  config IRINGBUF_SIZE
    int "指令环形缓冲区大小"
    default 16
    depends on IRINGBUF
    range 1 65536

  config WATCHPOINT
    bool "启用监视点"
    default n
    depends on SDB
    help
      启用监视点功能，用于监控表达式值的变化

  config WATCHPOINT_NUM
    int "监视点数量上限"
    default 32
    depends on WATCHPOINT
    range 1 65536
    help
      监视点编号池的大小上限，修改后需重新编译

  config DIFFTEST
    bool "启用差分测试difftest"
    default n
    help
      启用差分测试，并使用NEMU作为参考模型
      需要将NEMU编译为.so共享库
      使用make run diff=/path/to/nemu-so指定参考模型

endmenu
