# ysyx-workbench NEMU RV64 S-mode U-Boot.
#
# 以 qemu-riscv64_smode_defconfig 的 OpenSBI -> S-mode 模型为基础，
# 但只保留 NEMU 实际提供的设备：
#   - 64 MiB RAM @ 0x80000000
#   - ns16550a UART @ 0x10000000
#   - CLINT/PLIC（SBI timer/IPI）
#   - OpenSBI 通过 a1 传入的 DTB（OF_HAS_PRIOR_STAGE）
# 不启用 virtio/网络/磁盘/PCI/视频/USB；EFI loader 与 bootefi 必须保留，
# 因为 Debian riscv64 installer 的 install/vmlinux 是 EFI PE。
CONFIG_RISCV=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_SMODE=y
CONFIG_TARGET_NEMU_RISCV64=y
CONFIG_TEXT_BASE=0x80200000
CONFIG_DEFAULT_DEVICE_TREE="nemu-riscv64"

# U-Boot 自己重定位到 RAM 顶部；初始栈放在 U-Boot 映像之上，
# 避免压到 OpenSBI 的 2 MiB 固件区。
CONFIG_SYS_MALLOC_LEN=0x400000
CONFIG_STACK_SIZE=0x40000
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x80400000
CONFIG_SYS_LOAD_ADDR=0x81000000
CONFIG_SYS_BOOTM_LEN=0x04000000

CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_IS_NOWHERE=y

CONFIG_FIT=y
CONFIG_LMB=y
CONFIG_OF_LIBFDT=y
CONFIG_DISPLAY_CPUINFO=y
CONFIG_DISPLAY_BOARDINFO=y
# CONFIG_BOARD_INIT is not set
# CONFIG_NET is not set

CONFIG_BOOTDELAY=2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="echo NEMU U-Boot S-mode ready; echo Use nemu_reserve + bootefi, see UBOOT_NEMU.md"

# 控制台/定时器/复位：NEMU 的 16550 与 OpenSBI SBI timer/SRST。
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_RISCV_TIMER=y
CONFIG_SYSRESET=y
CONFIG_SYSRESET_SBI=y
CONFIG_CMD_POWEROFF=y
CONFIG_CMD_SBI=y

# 诊断命令：UART、timer、RAM。
CONFIG_CMD_BDI=y
CONFIG_CMD_CONSOLE=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_TIME=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_FDT=y
CONFIG_CMD_GO=y

# EFI loader / bootefi：Debian install/vmlinux 是 EFI PE。
CONFIG_BLK=y
CONFIG_EFI_LOADER=y
CONFIG_EFI_LOAD_FILE2_INITRD=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_HELLO=y
CONFIG_BOOTEFI_HELLO_COMPILE=y
