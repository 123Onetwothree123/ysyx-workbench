inline wchar_t *wcschr(wchar_t *string, wchar_t character)
{
  return ::wcschr(string, character);
}

inline const wchar_t *wcschr(const wchar_t *string, wchar_t character)
{
  return ::wcschr(string, character);
}

inline wchar_t *wcspbrk(wchar_t *string, const wchar_t *accept)
{
  return ::wcspbrk(string, accept);
}

inline const wchar_t *wcspbrk(
    const wchar_t *string,
    const wchar_t *accept)
{
  return ::wcspbrk(string, accept);
}

inline wchar_t *wcsrchr(wchar_t *string, wchar_t character)
