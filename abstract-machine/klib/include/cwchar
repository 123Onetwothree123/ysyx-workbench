inline wchar_t *wcsstr(wchar_t *haystack, const wchar_t *needle)
{
  return ::wcsstr(haystack, needle);
}

inline const wchar_t *wcsstr(
    const wchar_t *haystack,
    const wchar_t *needle)
{
